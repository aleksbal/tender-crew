{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CV",
  "type": "object",
  "required": [
    "personal_info",
    "summary",
    "experience",
    "education",
    "skills",
    "projects",
    "certifications",
    "languages"
  ],
  "properties": {
    "personal_info": {
      "type": "object",
      "required": ["first_name", "last_name", "phone", "email"],
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "linkedin": { "type": "string", "format": "uri" },
        "website": { "type": "string", "format": "uri" }
      }
    },
    "summary": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_date", "end_date", "company", "project", "role", "description"],
        "properties": {
          "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "company": { "type": "string" },
          "project": { "type": "string" },
          "role": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["degree", "institution", "start_date", "end_date", "location"],
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "location": { "type": "string" }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["programming_languages", "technologies", "soft_skills"],
      "properties": {
        "programming_languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "technologies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "soft_skills": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_date",
          "end_date",
          "project_name",
          "customer",
          "industry",
          "role",
          "role_description",
          "tools_and_frameworks"
        ],
        "properties": {
          "start_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "end_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "project_name": { "type": "string" },
          "customer": { "type": "string" },
          "industry": { "type": "string" },
          "role": { "type": "string" },
          "role_description": { "type": "string" },
          "tools_and_frameworks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "project_effort_percentage"],
              "properties": {
                "name": { "type": "string" },
                "project_effort_percentage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "issuer", "year"],
        "properties": {
          "title": { "type": "string" },
          "issuer": { "type": "string" },
          "year": { "type": "integer" }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "proficiency"],
        "properties": {
          "language": { "type": "string" },
          "proficiency": { "type": "string" }
        }
      }
    },
    "interests": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
