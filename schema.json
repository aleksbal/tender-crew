{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CVStructured",
  "type": "object",
  "properties": {
    "file_type": {"type": "string"},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_number": {"type": "integer"},
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bbox": {"type": ["array", "null"]},
                "text": {"type": "string"},
                "lines": {
                  "type": "array",
                  "items": {"type": "object", "properties": {"text": {"type": "string"}}}
                }
              },
              "required": ["text", "lines"]
            }
          }
        },
        "required": ["page_number", "blocks"]
      }
    }
  },
  "required": ["file_type", "pages"]
}
